+def integrity_report(data: np.ndarray, malformed: int = 0) -> Tuple[List[str], bool]:
+    """Integrity of a log from its own columns. Returns (text lines, ok).
+    Uses the daemon clock (Daemon t), the lost periods counted while receiving, the lines that could not be read, and the revolution count
+    against the integral of the filtered speed (a check that does not depend on the transport)."""
+    n = len(data)
+    lines: List[str] = [f"rows: {n}"]
+    ok = True
+    if n < 2:
+        return lines + ["too few rows to check"], False
+    t_d = data[:, IDX["daemon_t_s"]]
+    have_clock = bool(np.isfinite(t_d).any())
+    if have_clock:
+        dt = np.diff(t_d[np.isfinite(t_d)])
+        span = float(np.nansum(dt[dt > 0]))
+        expected = span / SAMPLE_PERIOD_S + 1
+        lost = np.nan_to_num(data[:, IDX["lost_periods"]], nan=0.0)
+        n_gaps = int((lost > 0).sum())
+        lines.append(f"daemon clock span: {span:.2f} s, expected rows {expected:.0f}, received {n} ({100.0 * (n / expected - 1):+.2f} %)")
+        lines.append(f"lost 10 ms periods: {int(lost.sum())} in {n_gaps} gaps, longest gap {int(lost.max())} periods")
+        lines.append(f"clock restarts (daemon time went backwards): {int((dt < 0).sum())}")
+        if lost.sum() > 0 or (dt < 0).any():
+            ok = False
+    else:
+        lines.append("no daemon clock in this log (basic telemetry): lost rows cannot be detected")
+    lines.append(f"lines that could not be read during the connection: {malformed}")
+    if malformed > 0:
+        ok = False
+    rev = data[:, IDX["revolutions"]]; filt = data[:, IDX["filt_rpm"]]
+    good = np.isfinite(rev) & np.isfinite(filt)
+    if good.sum() > 100:
+        counted = float(rev[good][-1] - rev[good][0]); integral = float(np.sum(filt[good]) * SAMPLE_PERIOD_S / 60.0)
+        if integral > 1.0:
+            diff = 100.0 * (integral / max(counted, 1e-9) - 1.0) if counted > 0 else float("inf")
+            lines.append(f"revolutions: counted {counted:.0f}, integral of the speed {integral:.0f} ({diff:+.2f} %)")
+            if abs(diff) > 2.0:
+                ok = False
+                lines.append("WARNING: the revolution count does not agree with the speed (index pulses rejected or missed?)")
+    lines.append("INTEGRITY: OK" if ok else "INTEGRITY: CHECK THE ITEMS ABOVE")
+    return lines, ok
+
